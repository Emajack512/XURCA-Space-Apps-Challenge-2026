{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrendScope",
  "version": "0.1.0",
  "identifier": "com.xurca.trend-scope",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "features": [
      "pytauri/standalone"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "TrendScope",
        "width": 1320,
        "height": 840
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Tendencias de datos ambientales públicos",
    "longDescription": "TrendScope descarga, grafica y analiza tendencias de datos ambientales públicos. NASA Space Apps 2026, equipo XURCA. Parte del código fue generado con asistencia de SI (Claude Code, Codex) y revisado por el equipo; el asistente de la app usa Gemini. Ver USO_DE_IA.md.",
    "copyright": "Equipo XURCA (Acrux), 2026"
  }
}
