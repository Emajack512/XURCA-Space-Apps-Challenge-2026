{
  "$defs": {
    "AnalysisSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "struct": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Struct",
          "type": "string"
        },
        "targets": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Targets",
          "type": "array"
        },
        "roles": {
          "additionalProperties": true,
          "title": "Roles",
          "type": "object"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "hypothesis": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hypothesis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "struct",
        "targets"
      ],
      "title": "AnalysisSpec",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "trend",
            "change_point",
            "threshold",
            "relationship",
            "forecast_threshold"
          ],
          "title": "Kind",
          "type": "string"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "increasing",
                "decreasing",
                "any"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "min_rate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Rate"
        },
        "operator": {
          "anyOf": [
            {
              "enum": [
                ">",
                "<",
                ">=",
                "<="
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "statistic": {
          "anyOf": [
            {
              "enum": [
                "last",
                "max",
                "min",
                "mean"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statistic"
        },
        "sign": {
          "anyOf": [
            {
              "enum": [
                "positive",
                "negative",
                "any"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sign"
        },
        "lags": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "maxItems": 12,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lags"
        },
        "window": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window"
        },
        "at_step": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At Step"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "Options": {
      "additionalProperties": false,
      "properties": {
        "include_steps": {
          "default": true,
          "title": "Include Steps",
          "type": "boolean"
        },
        "max_points_per_array": {
          "default": 5000,
          "maximum": 100000,
          "minimum": 50,
          "title": "Max Points Per Array",
          "type": "integer"
        },
        "allow_partial": {
          "default": true,
          "title": "Allow Partial",
          "type": "boolean"
        }
      },
      "title": "Options",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "earth-detective/request",
      "default": "earth-detective/request",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "request_id": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "origin": {
      "default": "manual",
      "enum": [
        "manual",
        "assistant"
      ],
      "title": "Origin",
      "type": "string"
    },
    "language": {
      "default": "es",
      "enum": [
        "es",
        "en"
      ],
      "title": "Language",
      "type": "string"
    },
    "investigation": {
      "additionalProperties": true,
      "title": "Investigation",
      "type": "object"
    },
    "analyses": {
      "items": {
        "$ref": "#/$defs/AnalysisSpec"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Analyses",
      "type": "array"
    },
    "options": {
      "$ref": "#/$defs/Options"
    }
  },
  "required": [
    "investigation",
    "analyses"
  ],
  "title": "RequestDocument",
  "type": "object"
}
